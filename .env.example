# Server
PORT=3001
NODE_ENV=production

# MongoDB Atlas (required on Vercel)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/elderease

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Admin (created on first DB connect)
ADMIN_EMAIL=admin@elderease.com
ADMIN_PASSWORD=Admin@123

# Frontend URL (password reset emails, admin links)
FRONTEND_URL=https://your-frontend.vercel.app

# Optional: restrict CORS (comma-separated origins, or leave unset for *)
# CORS_ORIGIN=https://your-frontend.vercel.app

# Stripe
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=ElderEase Admin
